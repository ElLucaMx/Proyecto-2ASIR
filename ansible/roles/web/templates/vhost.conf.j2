<VirtualHost *:80>
    ServerName {{ dominio_web }}

    DocumentRoot /var/www/guestbook

    <Directory /var/www/guestbook>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    DirectoryIndex index.php

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
